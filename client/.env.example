# ── Client Environment Variables ─────────────────────────────────────────────
# All VITE_* vars are exposed to the browser bundle via import.meta.env.
# DO NOT put secrets here — this file is baked into the JS bundle.

# Base server URL (no trailing slash).
# VITE_API_URL and VITE_SOCKET_URL are derived from this in src/config/env.ts.
VITE_BASE_URL=http://localhost:5000

# App environment
VITE_APP_ENV=development
