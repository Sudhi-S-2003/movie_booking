# ── Server environment ────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit real values.

NODE_ENV=development
PORT=5000

# MongoDB MUST run as a replica set (wallet, billing and chat writes use
# transactions). docker-compose starts a single-node replica set "rs0".
MONGODB_URI=mongodb://localhost:27017/saas-platform?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# Secrets: 32+ random characters each, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Separate key for signed links, captcha and webhook URLs (recommended).
SIGNING_SECRET=
JWT_EXPIRES_IN=15m

FRONTEND_URL=http://localhost:5173
# Extra allowed browser origins, comma separated (e.g. reseller domains).
CORS_EXTRA_ORIGINS=
# Number of reverse proxies in front of the API (0 when exposed directly).
TRUST_PROXY_HOPS=0

APP_NAME=Nexus Platform

# Protected platform owner (super admin). Created on first start; the
# password is only used for that first creation.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Owner

TELINFY_WEBHOOK_SECRET=

# Dev seed only (npm run seed): password for all demo accounts
SEED_USER_PASSWORD=Demo@12345
